							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id\": \"PAY-001\",\n  \"dateTime\": \"2024-01-15T10:30:00\",\n  \"value\": \"100.50\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/payments",
							"host": ["{{baseUrl}}"],
							"path": ["payments"]
						}
					}
				},
